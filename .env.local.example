# ── WCOS Local Development Environment Configuration ──────────────────

# Base URL Config
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Local DB Connection (Anvil/Local Postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/wcos?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/wcos?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/wcos_shadow?schema=public"

# Redis Config
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="wcos_local_secret_jwt_key_do_not_use_in_prod_12345"

# Web3 Network Setup (Base Sepolia Testnet)
CHAIN_ID="84532"
RPC_URL="https://sepolia.base.org"
NFT_CONTRACT_ADDRESS="0x498e82d77C29FAf0605a96E3D4F59E9E0C1BEc3A"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DAO_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Storage
STORAGE_PROVIDER="local"
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"

# AI
OPENAI_API_KEY="sk-proj-mock-key-for-local-development"

# News Sync
ENABLE_NEWS_SYNC=false
RSS_FEED_URLS="https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed"
