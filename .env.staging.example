# ── WCOS Staging Environment Configuration ───────────────────────────

PORT=3001
FRONTEND_URL="https://staging.wcos.io"

# Staging Database Setup (Cloud SQL Staging instance)
DATABASE_URL="postgresql://wcos_staging_user:stagingpassword@/wcos_staging_db?host=/cloudsql/YOUR_GCP_PROJECT_ID:us-central1:wcos-postgres-staging"
DIRECT_URL="postgresql://wcos_staging_user:stagingpassword@/wcos_staging_db?host=/cloudsql/YOUR_GCP_PROJECT_ID:us-central1:wcos-postgres-staging"

# Redis Config (Cloud Memorystore Staging)
REDIS_URL="redis://10.0.1.4:6379"

# Security (Should use Secret Manager reference in Cloud Run)
JWT_SECRET="wcos_staging_secret_key_from_secret_manager"

# Web3 Network Setup (Base Sepolia Testnet)
CHAIN_ID="84532"
RPC_URL="https://sepolia.base.org"
NFT_CONTRACT_ADDRESS="0x498e82d77C29FAf0605a96E3D4F59E9E0C1BEc3A"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DAO_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Storage
STORAGE_PROVIDER="gcs"
GCS_BUCKET_NAME="wcos-staging-assets"

# AI
OPENAI_API_KEY="sk-proj-staging-key"

# News Sync
ENABLE_NEWS_SYNC=true
RSS_FEED_URLS="https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed,https://cointelegraph.com/rss"
