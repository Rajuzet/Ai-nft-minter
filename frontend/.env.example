# ── WCOS Frontend Environment Variables ───────────────────────────────
# Copy this to .env.local and fill in your values

# Backend API (use Railway URL in production)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# WalletConnect — get yours at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id

# Base Network RPC URLs — get from https://alchemy.com
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed NFT minter contract address on Base Sepolia
NEXT_PUBLIC_AINFT_MINTER_ADDRESS=0x0000000000000000000000000000000000000000
