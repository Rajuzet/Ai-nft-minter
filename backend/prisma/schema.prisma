datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String               @id @default(uuid())
  walletAddress String               @unique
  displayName   String?
  bio           String?
  avatarUrl     String?
  bannerUrl     String?
  website       String?
  twitter       String?
  discord       String?
  instagram     String?
  verified      Boolean              @default(false)
  nonce         String?
  role          String               @default("CREATOR")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  profile       Profile?
  contracts     DeployedContract[]
  aiAssets      AiAsset[]
  collections   NftCollection[]
  nfts          Nft[]                @relation("UserNfts")
  listings      MarketplaceListing[] @relation("SellerListings")
  purchases     MarketplaceListing[] @relation("BuyerPurchases")
  daoProposals  DaoProposal[]
  daoVotes      DaoVote[]
  transactions  TransactionRecord[]
  auditLogs     AuditLog[]
  organizations OrganizationMember[]
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  website     String?
  twitter     String?
  discord     String?
  instagram   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  billingPlan String               @default("FREE")
  createdAt   DateTime             @default(now())
  members     OrganizationMember[]
  contracts   DeployedContract[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model DeployedContract {
  id              String        @id @default(uuid())
  ownerId         String
  organizationId  String?
  contractAddress String
  network         String
  contractType    String
  name            String?
  symbol          String?
  abi             String // stored as JSON string (SQLite compatibility)
  txHash          String
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([contractAddress, network])
}

model NftCollection {
  id              String               @id @default(uuid())
  ownerId         String
  contractAddress String
  network         String               @default("base-sepolia")
  name            String
  symbol          String
  maxSupply       Int                  @default(1000)
  mintedCount     Int                  @default(0)
  royaltyBps      Int                  @default(500)
  coverImage      String?
  description     String?
  status          String               @default("DEPLOYED")
  createdAt       DateTime             @default(now())
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings        MarketplaceListing[]
  nfts            Nft[]                @relation("CollectionNfts")
}

model Nft {
  id              String               @id @default(uuid())
  contractAddress String
  tokenId         Int
  ownerAddress    String
  minterAddress   String?
  tokenUri        String?
  name            String?
  description     String?
  imageUrl        String?
  chainId         Int                  @default(84532)
  blockNumber     Int                  @default(0)
  txHash          String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  ownerId         String?
  collectionId    String?
  owner           User?                @relation("UserNfts", fields: [ownerId], references: [id], onDelete: SetNull)
  collection      NftCollection?       @relation("CollectionNfts", fields: [collectionId], references: [id], onDelete: SetNull)
  listings        MarketplaceListing[] @relation("NftListings")

  @@unique([chainId, contractAddress, tokenId])
}

model IndexedNft {
  id              String   @id @default(uuid())
  contractAddress String
  tokenId         Int
  ownerAddress    String
  minterAddress   String?
  tokenUri        String?
  name            String?
  description     String?
  imageUrl        String?
  blockNumber     Int
  txHash          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contractAddress, tokenId])
}

model MarketplaceListing {
  id             String         @id @default(uuid())
  collectionId   String?
  nftId          String?
  nftAddress     String
  tokenId        Int
  sellerId       String
  buyerId        String?
  price          String
  collectionName String
  chain          String         @default("base-sepolia")
  imageUrl       String
  name           String
  description    String
  status         String         @default("ACTIVE")
  txHash         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  seller         User           @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer          User?          @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: SetNull)
  collection     NftCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  nft            Nft?           @relation("NftListings", fields: [nftId], references: [id], onDelete: SetNull)
  sales          NftSale[]      @relation("ListingSales")
}

model NftSale {
  id            String              @id @default(uuid())
  listingId     String?
  nftAddress    String
  tokenId       Int
  sellerAddress String
  buyerAddress  String
  price         String
  royaltyPaid   String              @default("0")
  txHash        String
  blockNumber   Int
  createdAt     DateTime            @default(now())
  listing       MarketplaceListing? @relation("ListingSales", fields: [listingId], references: [id], onDelete: SetNull)
}

model DaoOrganization {
  id              String        @id @default(uuid())
  name            String
  description     String
  govType         String        @default("Token-weighted")
  votingToken     String        @default("WGT")
  threshold       Int           @default(100)
  quorum          Int           @default(10)
  duration        Int           @default(5760)
  treasuryAddress String
  createdAt       DateTime      @default(now())
  proposals       DaoProposal[]
}

model DaoProposal {
  id               String          @id @default(uuid())
  daoId            String
  proposerId       String
  title            String
  description      String
  targetAddress    String
  valueTransferred String          @default("0")
  forVotes         Int             @default(0)
  againstVotes     Int             @default(0)
  status           String          @default("ACTIVE")
  createdAt        DateTime        @default(now())
  dao              DaoOrganization @relation(fields: [daoId], references: [id], onDelete: Cascade)
  proposer         User            @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  votes            DaoVote[]
}

model DaoVote {
  id         String      @id @default(uuid())
  proposalId String
  voterId    String
  support    Boolean
  weight     Int         @default(1)
  createdAt  DateTime    @default(now())
  proposal   DaoProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  voter      User        @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([proposalId, voterId])
}

model AiAsset {
  id              String   @id @default(uuid())
  userId          String
  prompt          String
  enhancedPrompt  String?
  stylePreset     String?
  category        String?
  imageUrl        String
  metadataUrl     String?
  storageProvider String   @default("local")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransactionRecord {
  id        String   @id @default(uuid())
  userId    String?
  txHash    String   @unique
  network   String
  type      String
  status    String   @default("CONFIRMED")
  details   String? // stored as JSON string
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ChainEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique // txHash-logIndex
  chainId         Int      @default(84532)
  network         String   @default("base-sepolia")
  contractAddress String
  eventName       String
  blockNumber     Int
  logIndex        Int
  txHash          String
  dataJson        String? // stored as JSON string
  createdAt       DateTime @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([contractAddress, eventName])
  @@index([blockNumber])
}

model IndexerState {
  id                 String   @id @default(uuid())
  network            String   @unique // e.g. "base-sepolia"
  lastProcessedBlock Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model NewsCategory {
  id               String            @id @default(uuid())
  name             String            @unique
  slug             String            @unique
  description      String?
  createdAt        DateTime          @default(now())
  newsArticles     NewsArticle[]     @relation("CategoryNewsArticles")
  magazineArticles MagazineArticle[] @relation("CategoryMagazineArticles")
}

model NewsSource {
  id        String        @id @default(uuid())
  name      String
  feedUrl   String        @unique
  category  String        @default("Web3")
  isTrusted Boolean       @default(true)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  articles  NewsArticle[] @relation("SourceArticles")
}

model NewsArticle {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  summary      String
  content      String?
  source       String
  sourceUrl    String        @unique
  url          String?       @unique
  imageUrl     String?
  category     String        @default("Web3")
  publishedAt  DateTime      @default(now())
  status       String        @default("PUBLISHED") // PUBLISHED | DRAFT | ARCHIVED
  isFeatured   Boolean       @default(false)
  readTime     String        @default("3 min")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sourceId     String?
  newsSource   NewsSource?   @relation("SourceArticles", fields: [sourceId], references: [id], onDelete: SetNull)
  categoryId   String?
  newsCategory NewsCategory? @relation("CategoryNewsArticles", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([status])
  @@index([publishedAt])
}

model MagazineArticle {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  excerpt      String
  content      String
  authorName   String
  authorRole   String?
  authorAvatar String?
  category     String        @default("founder-notes")
  imageUrl     String?
  publishedAt  DateTime      @default(now())
  isEditorPick Boolean       @default(false)
  isFeatured   Boolean       @default(false)
  readTime     String        @default("5 min")
  tags         String        @default("[]") // stored as JSON string array
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categoryId   String?
  newsCategory NewsCategory? @relation("CategoryMagazineArticles", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isFeatured])
}
