# ── WCOS Backend Environment Variables ────────────────────────────────
# Copy this to .env and fill in your values

# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-wcos.vercel.app

# AWS S3 (for NFT metadata + image storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-nft-metadata-bucket

# AI Image Generation
OPENAI_API_KEY=sk-your-openai-api-key

# Blockchain RPC
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ALCHEMY_API_KEY=your_alchemy_api_key

# Optional: Database (when you add persistence)
# DATABASE_URL=postgresql://user:pass@host:5432/wcos
