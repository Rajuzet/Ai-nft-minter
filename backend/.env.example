# Web3 Creator Operating System (WCOS) Backend Configuration

NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection (Cloud SQL or Local)
DATABASE_URL="postgresql://wcos_user:wcos_password@localhost:5432/wcos_db?schema=public"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# Storage Driver (gcs | s3 | ipfs)
STORAGE_PROVIDER=gcs

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=wcos-creator-assets
GCP_PROJECT_ID=wcos-production
GCP_SA_KEY='{"type": "service_account", ...}'

# AWS S3 Storage Configuration
S3_BUCKET_NAME=wcos-nft-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_PUBLIC_BASE_URL=https://wcos-nft-assets.s3.amazonaws.com

# Pinata IPFS Credentials
PINATA_JWT=eyJhbGciOi...

# AI Generation Engine Secrets
OPENAI_API_KEY=sk-proj-...
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=...
AWS_BEDROCK_SECRET_ACCESS_KEY=...

# Blockchain RPC Endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemycom/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
