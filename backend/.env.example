# Web3 Creator Operating System (WCOS) Backend Environment Variables

# Database Connection (SQLite: file:./dev.db | PostgreSQL: postgresql://user:pass@localhost:5432/wcos_db)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="wcos_super_secret_jwt_key_change_in_production_2026"

# Server Port & Allowed Frontend URL
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Blockchain RPC & Contract Addresses
RPC_URL="https://sepolia.base.org"
CHAIN_ID="84532"
NFT_CONTRACT_ADDRESS="0x498e82d77C29FAf0605a96E3D4F59E9E0C1BEc3A"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DAO_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Pinata / IPFS Provider Settings
STORAGE_PROVIDER="ipfs"
PINATA_JWT="YOUR_PINATA_JWT_BEARER_TOKEN_HERE"
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs/"

# Daily News RSS Ingestion Engine
ENABLE_NEWS_SYNC=true
RSS_FEED_URLS="https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed,https://cointelegraph.com/rss"
NEWS_API_KEY=""
