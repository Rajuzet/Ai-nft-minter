# Web3 Creator Operating System (WCOS) Backend Configuration

# Server & Network Settings
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=wcos_super_secret_jwt_key_change_in_production_2026

# Blockchain & Smart Contract Settings
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
CONTRACT_ADDRESS=0x498e82d77C29FAf0605a96E3D4F59E9E0C1BEc3A
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=YOUR_BASE_SEPOLIA_PRIVATE_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Database Connection (SQLite local dev: file:./dev.db | PostgreSQL: postgresql://user:pass@localhost:5432/wcos_db)
DATABASE_URL="file:./dev.db"

# Storage Driver (local | gcs | s3 | ipfs)
STORAGE_PROVIDER=local
GCS_BUCKET_NAME=wcos-creator-assets
S3_BUCKET_NAME=wcos-nft-assets
PINATA_JWT=YOUR_PINATA_JWT_TOKEN

# AI Art Generation API Keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
