# ── WCOS Production Environment Configuration ──────────────────────────

PORT=3001
FRONTEND_URL="https://app.wcos.io"

# Production Database Setup (Cloud SQL Production instance)
# Direct connection (non-pooled) is used for migrations, pooled for runtime
DATABASE_URL="postgresql://wcos_prod_user:YOUR_DB_PROD_PASSWORD@/wcos_prod_db?host=/cloudsql/YOUR_GCP_PROJECT_ID:us-central1:wcos-postgres-prod"
DIRECT_URL="postgresql://wcos_prod_user:YOUR_DB_PROD_PASSWORD@/wcos_prod_db?host=/cloudsql/YOUR_GCP_PROJECT_ID:us-central1:wcos-postgres-prod"

# Redis Config (Cloud Memorystore Production)
REDIS_URL="redis://10.0.1.5:6379"

# Security (Rely on GCP Secret Manager references in production)
JWT_SECRET="YOUR_JWT_SECRET_FROM_SECRET_MANAGER"

# Web3 Network Setup (Base Mainnet)
CHAIN_ID="8453"
RPC_URL="https://mainnet.base.org"
NFT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DAO_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Storage
STORAGE_PROVIDER="gcs"
GCS_BUCKET_NAME="wcos-production-assets"

# AI
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_FROM_SECRET_MANAGER"

# News Sync
ENABLE_NEWS_SYNC=true
RSS_FEED_URLS="https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed,https://cointelegraph.com/rss"
