# ── WCOS Development Environment Configuration ────────────────────────

PORT=3001
FRONTEND_URL="https://dev.wcos.io"

# Dev DB Connection (Cloud SQL Dev/Shared instance)
DATABASE_URL="postgresql://wcos_dev_user:devpassword@localhost:5432/wcos_dev?schema=public"
DIRECT_URL="postgresql://wcos_dev_user:devpassword@localhost:5432/wcos_dev?schema=public"

# Redis Config
REDIS_URL="redis://wcos-dev-redis:6379"

# Security
JWT_SECRET="wcos_dev_secret_key_needs_rotation"

# Web3 Network Setup (Base Sepolia Testnet)
CHAIN_ID="84532"
RPC_URL="https://sepolia.base.org"
NFT_CONTRACT_ADDRESS="0x498e82d77C29FAf0605a96E3D4F59E9E0C1BEc3A"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DAO_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Storage
STORAGE_PROVIDER="gcs"
GCS_BUCKET_NAME="wcos-dev-assets"

# AI
OPENAI_API_KEY="sk-proj-dev-key"

# News Sync
ENABLE_NEWS_SYNC=true
RSS_FEED_URLS="https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed"
